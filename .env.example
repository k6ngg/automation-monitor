# Credenciais de acesso ao DealerNet (Mantenha este arquivo apenas localmente)
DEALERNET_URL=https://dealernet.xxxxxxx.com.br/Portal/default.html
DEALERNET_USER=SEU_USUARIO
DEALERNET_PASS=SUA_SENHA

# Configurações de execução
# HEADLESS=true roda em segundo plano; HEADLESS=false abre o navegador na tela
HEADLESS=true
MAX_PAGES_PER_STATUS=5
MAX_PAGES_RENAVE=2
DESPREZAR_FICHA_GAMA_DO_DIA=true

# Notificação opcional por e-mail via Zoho Mail SMTP
# Se EMAIL_TO ficar em branco, envia por padrão para o próprio SMTP_USER
# Importante: se a senha contiver "#", coloque entre aspas simples (ex: '#minhaSenha')
EMAIL_ENABLED=false
EMAIL_ONLY_ON_ISSUES=false
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu.email@seudominio.com.br
SMTP_PASS=SUA_SENHA_OU_SENHA_DE_APP
EMAIL_FROM=
EMAIL_TO=
EMAIL_CC=
